# ==============================================================================
# ASTRA INTEL — Environment Configuration (Day 2)
# ==============================================================================
# Copy this file to .env and fill in your API key(s).
# Priority order: GROQ > GOOGLE GEMINI > OPENAI > OLLAMA (local fallback)
# Only ONE provider needs to be configured for Cloud mode.
# For Air-Gapped / Local mode, only OLLAMA settings are used.
# ==============================================================================

# ── Option 1: Groq (Recommended — fastest inference) ────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Option 2: Google Gemini ─────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Option 3: OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Option 4: Ollama (Local / Air-Gapped mode) ────────────────────────────
# No API key needed. Ensure `ollama serve` is running.
# Recommended models: llama3.2, mistral, qwen2.5
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
