# ==============================================================================
# ASTRA INTEL — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API key(s).
# Priority order: GROQ > GOOGLE GEMINI > OPENAI > OLLAMA (local fallback)
# Only ONE provider needs to be configured.
# ==============================================================================

# ── Option 1: Groq (Recommended — fastest inference) ────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ── Option 2: Google Gemini ─────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Option 3: OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Option 4: Ollama (Local fallback — no API key needed) ──────────────────
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
